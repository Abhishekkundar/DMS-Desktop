<Window x:Class="DMS.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMS - Login"
        Width="520"
        Height="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        FontFamily="Arial">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- TEXTBOX -->
        <!-- ========================================================= -->

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <!-- ========================================================= -->
        <!-- PASSWORD BOX -->
        <!-- ========================================================= -->

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <!-- ========================================================= -->
        <!-- COMBO BOX -->
        <!-- ========================================================= -->

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>


        <!-- ========================================================= -->
        <!-- BUTTON -->
        <!-- ========================================================= -->

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="Foreground" Value="#354957"/>
        </Style>


        <!-- ========================================================= -->
        <!-- PRIMARY BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background" Value="#315D7C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#294F69"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DEMO CAROUSEL ANIMATION -->
        <!-- ========================================================= -->

        <Storyboard x:Key="DemoCarouselStoryboard">

            <DoubleAnimation
                Storyboard.TargetName="DemoCarouselTransform"
                Storyboard.TargetProperty="X"
                From="360"
                To="-720"
                Duration="0:0:10"
                RepeatBehavior="Forever"/>

        </Storyboard>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- OUTER BORDER -->
    <!-- ============================================================= -->

    <Border Margin="34"
            Background="White"
            BorderBrush="#B8C3CC"
            BorderThickness="1">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="44"/>

                <!-- Main -->
                <RowDefinition Height="*"/>

                <!-- Footer -->
                <RowDefinition Height="50"/>

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                    Background="#E9EEF2"
                    BorderBrush="#B8C3CC"
                    BorderThickness="0,0,0,1">

                <TextBlock Text="DOCUMENT MANAGEMENT SYSTEM"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#263746"
                           VerticalAlignment="Center"
                           Margin="12,0"/>

            </Border>


            <!-- ===================================================== -->
            <!-- MAIN CONTENT -->
            <!-- ===================================================== -->

            <StackPanel Grid.Row="1"
                        Width="390"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">


                <!-- ================================================= -->
                <!-- APPLICATION ICON -->
                <!-- ================================================= -->

                <Border Width="48"
                        Height="48"
                        Background="#315D7C"
                        CornerRadius="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,8">

                    <TextBlock Text="✦"
                               Foreground="White"
                               FontSize="25"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- ================================================= -->
                <!-- SUB TITLE -->
                <!-- ================================================= -->

                <TextBlock Text="Government Document Management"
                           FontSize="12"
                           Foreground="#61717D"
                           HorizontalAlignment="Center"/>


                <!-- ================================================= -->
                <!-- MAIN TITLE -->
                <!-- ================================================= -->

                <TextBlock Text="DOCUMENT MANAGEMENT SYSTEM"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#263746"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,10"/>


                <!-- ================================================= -->
                <!-- DEMO VERSION CAROUSEL -->
                <!-- ================================================= -->

                <Border Height="32"
                        Background="#315D7C"
                        BorderBrush="#294F69"
                        BorderThickness="1"
                        CornerRadius="2"
                        ClipToBounds="True"
                        Margin="0,0,0,12">

                    <Canvas ClipToBounds="True">

                        <TextBlock x:Name="DemoCarouselText"
                                   Text="→ → →  ★ DOCUMENT MANAGEMENT SYSTEM — DEMO VERSION ★  → → →"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Width="720"
                                   Canvas.Top="7">

                            <TextBlock.RenderTransform>

                                <TranslateTransform
                                    x:Name="DemoCarouselTransform"
                                    X="360"
                                    Y="0"/>

                            </TextBlock.RenderTransform>

                        </TextBlock>

                    </Canvas>


                    <!-- Start animation automatically -->
                    <Border.Triggers>

                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

                            <BeginStoryboard>

                                <StaticResource ResourceKey="DemoCarouselStoryboard"/>

                            </BeginStoryboard>

                        </EventTrigger>

                    </Border.Triggers>

                </Border>


                <!-- ================================================= -->
                <!-- LOGIN BOX -->
                <!-- ================================================= -->

                <Border Background="#F7F9FA"
                        BorderBrush="#D0D8DE"
                        BorderThickness="1"
                        Padding="20">

                    <StackPanel>


                        <!-- ========================================= -->
                        <!-- LOGIN TITLE -->
                        <!-- ========================================= -->

                        <TextBlock Text="Administrator Login"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#315D7C"
                                   Margin="0,0,0,12"/>


                        <!-- ========================================= -->
                        <!-- USER ID -->
                        <!-- ========================================= -->

                        <TextBlock Text="User ID"
                                   FontSize="13"
                                   Foreground="#374957"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="UserIdBox"
                                 Text="admin"/>


                        <!-- ========================================= -->
                        <!-- PASSWORD -->
                        <!-- ========================================= -->

                        <TextBlock Text="Password"
                                   FontSize="13"
                                   Foreground="#374957"
                                   Margin="0,11,0,5"/>

                        <PasswordBox x:Name="PasswordBox"/>


                        <!-- ========================================= -->
                        <!-- LANGUAGE -->
                        <!-- ========================================= -->

                        <TextBlock Text="Language"
                                   FontSize="13"
                                   Foreground="#374957"
                                   Margin="0,11,0,5"/>

                        <ComboBox x:Name="LanguageBox"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="ಕನ್ನಡ"/>

                        </ComboBox>


                        <!-- ========================================= -->
                        <!-- ERROR MESSAGE -->
                        <!-- ========================================= -->

                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   Foreground="#B3261E"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>


                        <!-- ========================================= -->
                        <!-- BUTTONS -->
                        <!-- ========================================= -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,14,0,0">

                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Login"
                                    Click="Login_Click"/>

                            <Button Content="Exit"
                                    Click="Exit_Click"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

            </StackPanel>


            <!-- ===================================================== -->
            <!-- FOOTER -->
            <!-- ===================================================== -->

            <TextBlock Grid.Row="2"
                       Text="DMS | Version 1.0.0 (Demo)"
                       FontSize="11"
                       Foreground="#61717D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

    </Border>

</Window>