<Window x:Class="DMS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DOCUMENT MANAGEMENT SYSTEM"
        Width="1280"
        Height="800"
        MinWidth="1100"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F7"
        FontFamily="Arial">

    <Window.Resources>

        <!-- Default Button -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#354957"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Toolbar Button -->
        <Style x:Key="ToolbarButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#315D7C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#294F69"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#9B3434"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7F2929"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="#AEBBC5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Label -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#374957"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,5,0,3"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Main Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#C6D0D8"
                BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <!-- Logo + Title -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="34"
                            Height="34"
                            Background="#315D7C"
                            CornerRadius="2"
                            Margin="0,0,10,0">

                        <TextBlock Text="✦"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel>

                        <TextBlock Text="DOCUMENT MANAGEMENT SYSTEM"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#263746"/>

                        <TextBlock Text="Government Document Management"
                                   FontSize="11"
                                   Foreground="#61717D"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>


                <!-- Current User -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="User: "
                               Foreground="#526675"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CurrentUserText"
                               FontWeight="Bold"
                               Foreground="#263746"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- TOOLBAR -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Background="#E9EEF2"
                BorderBrush="#C6D0D8"
                BorderThickness="0,0,0,1">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">

                <StackPanel Orientation="Horizontal"
                            Margin="10,3">

                    <Button x:Name="CreateUserButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="👤  Create User"
                            Click="CreateUser_Click"/>

                    <Button x:Name="DeleteUserButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="👤  Delete User"
                            Click="DeleteUser_Click"/>

                    <Button x:Name="SearchButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="🔎  Search"
                            Click="Search_Click"/>

                    <Button x:Name="IndexButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="▣  Index"
                            Click="Index_Click"/>

                    <Button x:Name="UploadButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="↑  Upload"
                            Click="Upload_Click"/>

                    <Button x:Name="ExcelButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="▤  Excel"
                            Click="Excel_Click"/>

                    <Button x:Name="DeleteButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="✕  Delete"
                            Click="Delete_Click"/>

                    <Button x:Name="EditButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="✎  Edit"
                            Click="Edit_Click"/>

                    <Button x:Name="LogoutButton"
                            Style="{StaticResource ToolbarButton}"
                            Content="⇥  Logout"
                            Click="Logout_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ========================================================= -->

        <Grid Grid.Row="2"
              Margin="14">

            <Border Background="White"
                    BorderBrush="#C6D0D8"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Section Header -->
                    <Border Background="#E9EEF2"
                            BorderBrush="#B8C3CC"
                            BorderThickness="0,0,0,1">

                        <TextBlock x:Name="SectionTitle"
                                   Text="Document Management System"
                                   FontWeight="SemiBold"
                                   Foreground="#263746"
                                   VerticalAlignment="Center"
                                   Margin="12,0"/>

                    </Border>


                    <!-- Panels -->
                    <Grid Grid.Row="1"
                          Margin="18">


                        <!-- ================================================= -->
                        <!-- HOME -->
                        <!-- ================================================= -->

                        <StackPanel x:Name="HomePanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Document Management System"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#315D7C"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Select an option from the toolbar"
                                       FontSize="14"
                                       Foreground="#657682"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- SEARCH -->
                        <!-- ================================================= -->

                        <Grid x:Name="SearchPanel"
                              Visibility="Collapsed">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <UniformGrid Rows="2"
                                         Columns="4"
                                         Margin="0,0,0,10">

                                <StackPanel Margin="5">
                                    <Label Content="Project Code"/>
                                    <TextBox x:Name="SearchProjectCodeBox"/>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <Label Content="Unit"/>
                                    <ComboBox x:Name="SearchUnitCombo">
                                        <ComboBoxItem Content="--All--"/>
                                        <ComboBoxItem Content="Finance"/>
                                        <ComboBoxItem Content="Works"/>
                                        <ComboBoxItem Content="Administration"/>
                                        <ComboBoxItem Content="Education"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <Label Content="Year"/>
                                    <ComboBox x:Name="SearchYearCombo">
                                        <ComboBoxItem Content="--All--"/>
                                        <ComboBoxItem Content="2026"/>
                                        <ComboBoxItem Content="2025"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <Label Content="Month"/>
                                    <ComboBox x:Name="SearchMonthCombo">
                                        <ComboBoxItem Content="--All--"/>
                                        <ComboBoxItem Content="January"/>
                                        <ComboBoxItem Content="February"/>
                                        <ComboBoxItem Content="March"/>
                                        <ComboBoxItem Content="April"/>
                                        <ComboBoxItem Content="May"/>
                                        <ComboBoxItem Content="June"/>
                                        <ComboBoxItem Content="July"/>
                                        <ComboBoxItem Content="August"/>
                                        <ComboBoxItem Content="September"/>
                                        <ComboBoxItem Content="October"/>
                                        <ComboBoxItem Content="November"/>
                                        <ComboBoxItem Content="December"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <Label Content="Voucher Type"/>
                                    <ComboBox x:Name="SearchVoucherCombo">
                                        <ComboBoxItem Content="--All--"/>
                                        <ComboBoxItem Content="Invoice"/>
                                        <ComboBoxItem Content="Contract"/>
                                        <ComboBoxItem Content="Letter"/>
                                        <ComboBoxItem Content="Report"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <Label Content="Name / Description"/>
                                    <TextBox x:Name="SearchDescriptionBox"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            Margin="5">

                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Search"
                                            Width="90"
                                            Click="SearchExecute_Click"/>

                                    <Button Content="Clear"
                                            Width="75"
                                            Click="SearchClear_Click"/>

                                </StackPanel>

                            </UniformGrid>


                            <TextBlock Grid.Row="1"
                                       Text="Search Results"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#354957"
                                       Margin="5,5,0,8"/>


                            <DataGrid x:Name="DocumentsGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      BorderBrush="#AEBBC5"
                                      RowHeight="34"
                                      FontSize="12"
                                      SelectionChanged="DocumentsGrid_SelectionChanged">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Sl.No"
                                                        Binding="{Binding SlNo}"
                                                        Width="55"/>

                                    <DataGridTextColumn Header="Document No."
                                                        Binding="{Binding DocumentNo}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Project Code"
                                                        Binding="{Binding ProjectCode}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Unit"
                                                        Binding="{Binding Unit}"
                                                        Width="115"/>

                                    <DataGridTextColumn Header="Year"
                                                        Binding="{Binding Year}"
                                                        Width="70"/>

                                    <DataGridTextColumn Header="Month"
                                                        Binding="{Binding Month}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="Voucher Type"
                                                        Binding="{Binding VoucherType}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Name / Description"
                                                        Binding="{Binding Description}"
                                                        Width="*"/>


                                    <DataGridTemplateColumn Header="Action"
                                                            Width="230">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <StackPanel Orientation="Horizontal">

                                                    <Button Content="View"
                                                            Padding="9,4"
                                                            Click="View_Click"/>

                                                    <Button Content="Reply"
                                                            Padding="9,4"
                                                            Click="Reply_Click"/>

                                                    <Button Content="Print"
                                                            Padding="9,4"
                                                            Click="Print_Click"/>

                                                </StackPanel>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- CREATE USER -->
                        <!-- ================================================= -->

                        <Grid x:Name="CreateUserPanel"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel MaxWidth="720">

                                    <Label Content="Create Account"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>


                                    <UniformGrid Columns="2"
                                                 Margin="0,5">

                                        <Label Content="Name"/>
                                        <TextBox x:Name="UserNameBox"/>

                                        <Label Content="Employee ID"/>
                                        <TextBox x:Name="EmployeeIdBox"/>

                                        <Label Content="User ID"/>
                                        <TextBox x:Name="UserIdBox"/>

                                        <Label Content="Password"/>
                                        <PasswordBox x:Name="UserPasswordBox"
                                                     Margin="0,5"/>

                                    </UniformGrid>


                                    <!-- Permissions -->
                                    <GroupBox Header="Permissions"
                                              Margin="5,10">

                                        <UniformGrid Columns="2"
                                                     Margin="10">

                                            <CheckBox x:Name="PermissionCreate"
                                                      Content="Create User"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionDeleteUser"
                                                      Content="Delete User"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionSearch"
                                                      Content="Search"
                                                      Margin="5"
                                                      IsChecked="True"/>

                                            <CheckBox x:Name="PermissionIndex"
                                                      Content="Index"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionUpload"
                                                      Content="Upload"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionExcel"
                                                      Content="Excel"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionEdit"
                                                      Content="Edit"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionDelete"
                                                      Content="Delete"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionReply"
                                                      Content="Reply"
                                                      Margin="5"/>

                                            <CheckBox x:Name="PermissionPrint"
                                                      Content="Print"
                                                      Margin="5"/>

                                        </UniformGrid>

                                    </GroupBox>


                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right">

                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Create"
                                                Width="90"
                                                Click="SaveUser_Click"/>

                                        <Button Content="Clear"
                                                Width="90"
                                                Click="CreateUserClear_Click"/>

                                    </StackPanel>

                                </StackPanel>

                            </ScrollViewer>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- DELETE USER -->
                        <!-- ================================================= -->

                        <Grid x:Name="DeleteUserPanel"
                              Visibility="Collapsed">

                            <StackPanel MaxWidth="650">

                                <Label Content="Delete User"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                                <Label Content="Select User"/>

                                <ComboBox x:Name="DeleteUserCombo"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,15,0,0">

                                    <Button Style="{StaticResource DangerButton}"
                                            Content="Delete User"
                                            Width="110"
                                            Click="DeleteUserConfirm_Click"/>

                                    <Button Content="Clear"
                                            Width="90"
                                            Click="DeleteUserClear_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- INDEX -->
                        <!-- ================================================= -->

                        <Grid x:Name="IndexPanel"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <Grid MaxWidth="900">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <Label Grid.Row="0"
                                           Grid.Column="0"
                                           Content="Document No."/>

                                    <TextBox x:Name="IndexDocumentNoBox"
                                             Grid.Row="0"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Content="Project Code"/>

                                    <TextBox x:Name="IndexProjectCodeBox"
                                             Grid.Row="1"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Content="Unit"/>

                                    <ComboBox x:Name="IndexUnitCombo"
                                              Grid.Row="2"
                                              Grid.Column="1">

                                        <ComboBoxItem Content="Finance"/>
                                        <ComboBoxItem Content="Works"/>
                                        <ComboBoxItem Content="Administration"/>
                                        <ComboBoxItem Content="Education"/>

                                    </ComboBox>


                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Content="Year"/>

                                    <ComboBox x:Name="IndexYearCombo"
                                              Grid.Row="3"
                                              Grid.Column="1">

                                        <ComboBoxItem Content="2026"/>
                                        <ComboBoxItem Content="2025"/>

                                    </ComboBox>


                                    <Label Grid.Row="4"
                                           Grid.Column="0"
                                           Content="Month"/>

                                    <ComboBox x:Name="IndexMonthCombo"
                                              Grid.Row="4"
                                              Grid.Column="1">

                                        <ComboBoxItem Content="January"/>
                                        <ComboBoxItem Content="February"/>
                                        <ComboBoxItem Content="March"/>
                                        <ComboBoxItem Content="April"/>
                                        <ComboBoxItem Content="May"/>
                                        <ComboBoxItem Content="June"/>
                                        <ComboBoxItem Content="July"/>
                                        <ComboBoxItem Content="August"/>
                                        <ComboBoxItem Content="September"/>
                                        <ComboBoxItem Content="October"/>
                                        <ComboBoxItem Content="November"/>
                                        <ComboBoxItem Content="December"/>

                                    </ComboBox>


                                    <Label Grid.Row="5"
                                           Grid.Column="0"
                                           Content="Voucher Type"/>

                                    <ComboBox x:Name="IndexVoucherCombo"
                                              Grid.Row="5"
                                              Grid.Column="1">

                                        <ComboBoxItem Content="Invoice"/>
                                        <ComboBoxItem Content="Contract"/>
                                        <ComboBoxItem Content="Letter"/>
                                        <ComboBoxItem Content="Report"/>

                                    </ComboBox>


                                    <Label Grid.Row="6"
                                           Grid.Column="0"
                                           Content="Name / Description"/>

                                    <TextBox x:Name="IndexDescriptionBox"
                                             Grid.Row="6"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="7"
                                           Grid.Column="0"
                                           Content="Document File"/>

                                    <StackPanel Grid.Row="7"
                                                Grid.Column="1"
                                                Orientation="Horizontal">

                                        <TextBox x:Name="IndexFileBox"
                                                 IsReadOnly="True"
                                                 MinWidth="500"/>

                                        <Button Content="Choose File"
                                                Width="110"
                                                Click="IndexChooseFile_Click"/>

                                    </StackPanel>


                                    <StackPanel Grid.Row="8"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,15,0,0">

                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Save"
                                                Width="90"
                                                Click="IndexSave_Click"/>

                                        <Button Content="Clear"
                                                Width="90"
                                                Click="IndexClear_Click"/>

                                    </StackPanel>

                                </Grid>

                            </ScrollViewer>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- UPLOAD -->
                        <!-- ================================================= -->

                        <Grid x:Name="UploadPanel"
                              Visibility="Collapsed">

                            <StackPanel MaxWidth="850">

                                <Label Content="Upload Document"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                                <Label Content="Document No. (must already exist in Index)"/>

                                <TextBox x:Name="UploadDocumentNoBox"/>

                                <Label Content="Selected File"/>

                                <StackPanel Orientation="Horizontal">

                                    <TextBox x:Name="UploadFileBox"
                                             IsReadOnly="True"
                                             MinWidth="650"/>

                                    <Button Content="Choose File"
                                            Width="110"
                                            Click="UploadChooseFile_Click"/>

                                </StackPanel>


                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,15,0,0">

                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Upload File"
                                            Width="100"
                                            Click="UploadSave_Click"/>

                                    <Button Content="Clear"
                                            Width="90"
                                            Click="UploadClear_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- EXCEL -->
                        <!-- ================================================= -->

                        <Grid x:Name="ExcelPanel"
                              Visibility="Collapsed">

                            <StackPanel MaxWidth="700">

                                <Label Content="Excel Report"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>

                                <Label Content="Report File Name"/>

                                <TextBox x:Name="ExcelFileNameBox"
                                         Text="DMS_Report"/>

                                <TextBlock Text="The report will contain the current search results and can be opened in Microsoft Excel."
                                           TextWrapping="Wrap"
                                           Foreground="#61717D"
                                           Margin="0,10"/>


                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Generate Report"
                                            Width="125"
                                            Click="ExcelGenerate_Click"/>

                                    <Button Content="Clear"
                                            Width="90"
                                            Click="ExcelClear_Click"/>

                                </StackPanel>

                            </StackPanel>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- EDIT -->
                        <!-- ================================================= -->

                        <Grid x:Name="EditPanel"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <Grid MaxWidth="900">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>


                                    <Label Grid.Row="0"
                                           Grid.Column="0"
                                           Content="Document No."/>

                                    <TextBox x:Name="EditDocumentNoBox"
                                             Grid.Row="0"
                                             Grid.Column="1"
                                             IsReadOnly="True"/>


                                    <Label Grid.Row="1"
                                           Grid.Column="0"
                                           Content="Project Code"/>

                                    <TextBox x:Name="EditProjectCodeBox"
                                             Grid.Row="1"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="2"
                                           Grid.Column="0"
                                           Content="Unit"/>

                                    <TextBox x:Name="EditUnitBox"
                                             Grid.Row="2"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="3"
                                           Grid.Column="0"
                                           Content="Year"/>

                                    <TextBox x:Name="EditYearBox"
                                             Grid.Row="3"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="4"
                                           Grid.Column="0"
                                           Content="Month"/>

                                    <TextBox x:Name="EditMonthBox"
                                             Grid.Row="4"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="5"
                                           Grid.Column="0"
                                           Content="Voucher Type"/>

                                    <TextBox x:Name="EditVoucherBox"
                                             Grid.Row="5"
                                             Grid.Column="1"/>


                                    <Label Grid.Row="6"
                                           Grid.Column="0"
                                           Content="Name / Description"/>

                                    <TextBox x:Name="EditDescriptionBox"
                                             Grid.Row="6"
                                             Grid.Column="1"/>


                                    <StackPanel Grid.Row="7"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,15,0,0">

                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Update"
                                                Width="90"
                                                Click="EditSave_Click"/>

                                        <Button Content="Clear"
                                                Width="90"
                                                Click="EditClear_Click"/>

                                    </StackPanel>

                                </Grid>

                            </ScrollViewer>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- REPLY -->
                        <!-- ================================================= -->

                        <Grid x:Name="ReplyPanel"
                              Visibility="Collapsed">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel MaxWidth="1050">


                                    <Grid Margin="0,0,0,12">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>


                                        <StackPanel Grid.Column="0"
                                                    Margin="5">

                                            <Label Content="Request No."/>

                                            <TextBox x:Name="ReplyRequestNoBox"/>

                                        </StackPanel>


                                        <StackPanel Grid.Column="1"
                                                    Margin="5">

                                            <Label Content="Request Date"/>

                                            <TextBox x:Name="ReplyRequestDateBox"/>

                                        </StackPanel>

                                    </Grid>


                                    <StackPanel Margin="5">

                                        <Label Content="Document No."/>

                                        <TextBox x:Name="ReplyDocumentNoBox"
                                                 IsReadOnly="True"/>

                                    </StackPanel>


                                    <StackPanel Margin="5">

                                        <Label Content="To *"/>

                                        <TextBox x:Name="ReplyToBox"/>

                                    </StackPanel>


                                    <StackPanel Margin="5">

                                        <Label Content="Address"/>

                                        <TextBox x:Name="ReplyAddressBox"
                                                 Height="70"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"/>

                                    </StackPanel>


                                    <StackPanel Margin="5">

                                        <Label Content="Subject"/>

                                        <TextBox x:Name="ReplySubjectBox"/>

                                    </StackPanel>


                                    <StackPanel Margin="5">

                                        <Label Content="Reference"/>

                                        <TextBox x:Name="ReplyReferenceBox"/>

                                    </StackPanel>


                                    <StackPanel Margin="5">

                                        <Label Content="Reply *"/>

                                        <TextBox x:Name="ReplyTextBox"
                                                 Height="210"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>

                                    </StackPanel>


                                    <StackPanel Margin="5">

                                        <Label Content="Attachment"/>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBox x:Name="ReplyAttachmentBox"
                                                     IsReadOnly="True"
                                                     MinWidth="700"/>

                                            <Button Content="Choose File"
                                                    Width="110"
                                                    Click="ReplyChooseFile_Click"/>

                                        </StackPanel>

                                    </StackPanel>


                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="5,15,5,5">

                                        <Button Content="Clear"
                                                Width="85"
                                                Click="ReplyClear_Click"/>

                                        <Button Style="{StaticResource PrimaryButton}"
                                                Content="Reply"
                                                Width="85"
                                                Click="ReplySubmit_Click"/>

                                        <Button Content="🖨 Print"
                                                Width="95"
                                                Click="ReplyPrint_Click"/>

                                    </StackPanel>

                                </StackPanel>

                            </ScrollViewer>

                        </Grid>

                    </Grid>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Background="#E9EEF2"
                BorderBrush="#C6D0D8"
                BorderThickness="0,1,0,0">

            <TextBlock x:Name="StatusText"
                       Text="DMS | Ready"
                       Foreground="#526675"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="12,0"/>

        </Border>

    </Grid>

</Window>